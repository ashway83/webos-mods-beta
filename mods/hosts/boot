#!/bin/ash
# Overlay the read-only /etc/hosts with the entries it has plus our blocklist, behind a
# marker line of our own. It builds on the file as it finds it: Homebrew Channel, when
# it blocks system updates, mounts a copy of its own over /etc/hosts before our hook runs.
# Runs at every boot (and once at install). Keep it quick and idempotent.
# MODS_HOSTS_FILE points it at another file (the tests use that).
# shellcheck shell=dash
D=${0%/*}
F=${MODS_HOSTS_FILE:-/etc/hosts}
MARK='# webos-mods: the hosts mod blocklist'
grep -qxF "$MARK" "$F" && exit 0                 # already applied this boot
{ cat "$F"; echo; echo "$MARK"; cat "$D/blocklist"; } >"$D/hosts"
mount -o bind "$D/hosts" "$F"
