#!/bin/ash
# Undo boot: take off our own bind mount, when it's the one showing (its marker line is
# there), and the file below shows through again: the stock one, or another mount, such
# as Homebrew Channel's. A mount that isn't ours is left alone.
# shellcheck shell=dash

F=${MODS_HOSTS_FILE:-/etc/hosts}
MARK='# webos-mods: the hosts mod blocklist'
if grep -qxF "$MARK" "$F"; then umount "$F"; fi
